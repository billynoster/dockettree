# Docket Tree local environment
# Copy to `.env` if you want; the server reads process env, not this file automatically.
# Leave Firebase unset to keep local email/password + session cookies (the cloud preview).

# --- Firebase Authentication (Email/Password only; do not set Analytics) ---
# Required together to switch the production path to Firebase:
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=
# Optional:
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# Do not set FIREBASE_MEASUREMENT_ID — Analytics is not initialized.
# VITE_FIREBASE_* aliases are accepted by the server for local shells.

# --- SMTP (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Runtime ---
# PORT=43217
# HOST=127.0.0.1
# PUBLIC_URL=http://127.0.0.1:43217
# SECURE_COOKIES=false
# DOCKSY_DATA_DIR=./var
