# Docket Tree local environment
# Copy to `.env` if you want; the server reads process env, not this file automatically.
# Leave Firebase / Cloud SQL / GCS unset to keep local email/password + SQLite + disk uploads.

# --- Firebase Authentication (Email/Password only; do not set Analytics) ---
# Required together to switch the production path to Firebase:
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=
# Optional:
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# Do not set FIREBASE_MEASUREMENT_ID — Analytics is not initialized.
# VITE_FIREBASE_* aliases are accepted by the server for local shells.

# --- SMTP (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Runtime ---
# PORT=43217
# HOST=127.0.0.1
# PUBLIC_URL=http://127.0.0.1:43217
# SECURE_COOKIES=false
# DOCKSY_DATA_DIR=./var

# --- Durable storage (Cloud Run production only; leave unset for npm run dev) ---
# Postgres when any of these are set (prefer Unix socket on Cloud Run):
# DATABASE_URL=
# CLOUD_SQL_CONNECTION_NAME=docket-tree-510523:us-central1:docket-tree-db
# INSTANCE_UNIX_SOCKET=/cloudsql/docket-tree-510523:us-central1:docket-tree-db
# DATABASE_USER=docksy
# DATABASE_PASSWORD=   # use Secret Manager on Cloud Run — never commit
# DATABASE_NAME=docksy
# CLOUD_SQL_USE_CONNECTOR=false
# Document bytes in GCS (not container disk):
# GCS_BUCKET=docket-tree-uploads
# DOCKSY_GCS_BUCKET=   # alias for GCS_BUCKET
